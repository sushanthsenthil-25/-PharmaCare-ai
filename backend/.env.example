# MongoDB Atlas Configuration
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=pharmacare_ai

# JWT Authentication (generate 64-character random strings for production)
JWT_SECRET=your-secure-random-64-character-jwt-secret-key
JWT_REFRESH_SECRET=your-secure-random-64-character-refresh-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated, specify your frontend Vercel domain)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# AI & External Integrations (Optional)
GEMINI_API_KEY=
AI_API_KEY=
STT_API_KEY=
TTS_API_KEY=
REDIS_URL=

# Environment (development | production)
ENVIRONMENT=production
